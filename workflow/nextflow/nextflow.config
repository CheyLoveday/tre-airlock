// Minimal Nextflow config for the port skeleton. On DNAnexus this would target the dx executor;
// locally it runs each process as a shell task in the uv environment. Illustrative, not tuned.
manifest {
    name        = 'ofh-feasibility'
    description = 'Genotype-feasibility DAG (port skeleton; same core as the Snakemake path)'
    mainScript = 'main.nf'
}

process {
    executor = 'local'
}
